evaluate-commands %sh{
    # SSH must take priority over clipboard tools on the remote host.
    if [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
        cat << 'EOF'
        map -docstring 'Copy via OSC 52' global user y '<a-|> { printf "\033]52;c;"; base64 | tr -d "\n"; printf "\007"; } > /dev/tty<ret>'
EOF

    elif command -v pbcopy >/dev/null 2>&1; then
        echo "map -docstring 'Copy to macOS clipboard' global user y '<a-|> pbcopy<ret>'"
        echo "map -docstring 'Paste from macOS clipboard' global user p '<a-!> pbpaste<ret>'"

    # 3. Linux ローカル (Wayland環境)
    elif command -v wl-copy >/dev/null 2>&1; then
        echo "map -docstring 'Copy to Wayland clipboard' global user y '<a-|> wl-copy<ret>'"
        echo "map -docstring 'Paste from Wayland clipboard' global user p '<a-!> wl-paste<ret>'"

    # 4. Linux ローカル (X11環境)
    elif command -v xsel >/dev/null 2>&1; then
        echo "map -docstring 'Copy to X11 clipboard' global user y '<a-|> xsel --input --clipboard<ret>'"
        echo "map -docstring 'Paste from X11 clipboard' global user p '<a-!> xsel --output --clipboard<ret>'"
    elif command -v xclip >/dev/null 2>&1; then
        echo "map -docstring 'Copy to X11 clipboard' global user y '<a-|> xclip -selection clipboard<ret>'"
        echo "map -docstring 'Paste from X11 clipboard' global user p '<a-!> xclip -selection clipboard -o<ret>'"
    fi
}

